# One allowlist for both images, so `docker compose build` works on a plain Docker
# install with no buildx plugin (a per-Dockerfile ignore file needs BuildKit).
# The worker image still copies only ingest code, the spot catalogues and the
# schedule; the site image is the only one that reads the frontend sources.
**
!force5/
!force5/Dockerfile
!force5/ingest/
!force5/ingest/*.py
!force5/ingest/requirements*.txt
!deploy/
!deploy/local/
!deploy/local/jobs.toml
!deploy/local/Caddyfile
!public/
!public/*.json
!public/favicon.svg
!public/weather/**
!package.json
!package-lock.json
# Marketplace API image (market/Dockerfile) builds from this same root context.
!market/**
market/api/dist
# The API imports the site's users module (site/api, site/shared).
!site/**
# And runs the community's migrations at boot (community/api, community/shared).
!community/**
!tsconfig.json
!vite.config.ts
!index.html
!data/
!data/locations/*.json
!src/**
!force5/src/**
!force5/assets/**
# The marketplace stylesheet imports the design system's tokens and component CSS.
!design/
!design/*/
!design/*/*.css
# Never build from a local install, build output, cache or credential file.
**/node_modules
dist
.venv
.cache
**/__pycache__
**/*.pyc
.env
.env.*
!.env.example
