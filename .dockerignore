# One allowlist for both images, so `docker compose build` works on a plain Docker
# install with no buildx plugin (a per-Dockerfile ignore file needs BuildKit).
# The worker image copies only ingest code, the spot catalogues, the schedule and
# the blend, bundled in a build stage from the frontend sources it shares.
**
!force5/
!force5/Dockerfile
!force5/ingest/
!force5/ingest/*.py
!force5/ingest/requirements*.txt
!force5/blend/
!force5/blend/*.ts
# The run layout the blend job publishes its spot squares in.
!scripts/
!scripts/runs.mjs
!deploy/
!deploy/local/
!deploy/local/jobs.toml
!deploy/local/Caddyfile
!public/
!public/*.json
!public/favicon.svg
!public/weather/**
!package.json
!package-lock.json
# Marketplace API image (market/Dockerfile) builds from this same root context.
!market/**
market/api/dist
# The API imports the site's users module (site/api, site/shared).
!site/**
# And runs the community's migrations at boot (community/api, community/shared).
!community/**
# The MCP server, Gust and the AI page, which the API serves and the site imports.
!mcp/**
!companion/**
# The app's star-condition alerts, which the API serves (alerts/api, alerts/shared).
!alerts/**
!ai/**
# The spot pages, a lazy bundle of the site.
!spot/**
# The site image builds the browser code every section shares (shared/web).
!shared/**
# ...and the Tailwind theme src/main.tsx imports (ui/theme.css).
!ui/**
!tsconfig.json
!vite.config.ts
!index.html
!data/
!data/locations/*.json
!src/**
!force5/src/**
# The shared test helper that tests under src/ and community/ import; tsc -b
# type-checks them in the site build (the fixtures it reads are not needed).
!tests/
!tests/bundles.ts
!force5/assets/**
# Never build from a local install, build output, cache or credential file.
**/node_modules
dist
.venv
.cache
**/__pycache__
**/*.pyc
.env
.env.*
!.env.example
