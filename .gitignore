perf-report/
playwright-report/
.env
.env.local
.env.*
!.env.example
# Bucket credentials for the importer (docs/CLOUDFLARE_R2_SETUP.md).
*.env
.codex/
.multicode/
.claude/
.agents/
.grok/
.opencode/
.mcp.json
# Forecast data is generated by the ingest jobs (npm run weather:refresh*), never committed.
public/weather/
# Generated tide predictions; nothing marine is bundled yet.
public/marine/
*.tsbuildinfo

# SprintEngine Studio workspace files (plugin.json, marketplace.json): app-owned, per machine.
.sprintengine/

# Home Compute on the Mac mini: controller state, written at runtime.
deploy/home-compute/state/

# The blend job's bundle, built inside the forecast image (force5/Dockerfile).
force5/blend/dist/

# The national foilable-depth regions: on the data host only (scripts/foildepth/publish.py),
# too large to commit. A local copy beside the pilots, for the dev server, stays out of git.
public-data/foildepth/*/tide-*.pmtiles

# wrangler pages dev (local MCP worker checks)
.wrangler/
