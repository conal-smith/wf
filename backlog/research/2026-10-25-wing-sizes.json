{
 "title": "Recommended wing size from steady wind and rider weight",
 "date": "2026-10-25",
 "units": {
  "wind": "knots (mean/steady wind, not gusts)",
  "size": "m²",
  "weight": "kg"
 },
 "model": {
  "formula": "size_m2 = c * (weightKg / 75)^a / windKn^k, then rounded to the nearest common size step",
  "constants": {
   "c": 64.0,
   "k": 0.9,
   "a": 0.46,
   "reference_kg": 75
  },
  "constants_unrounded": {
   "c": 64.13,
   "k": 0.901,
   "a": 0.464
  },
  "fitted_to": "Mid-points (min+max)/2 of 141 published size/wind rows from 21 wing models across 9 brands, plus 8 points from published brand weight rules (Sroka, North). Open-ended ranges (e.g. \"35+\") excluded. Rows with no stated reference weight treated as 75 kg; Ozone as 80 kg; Gong bands as 60 / 75 / 92 kg.",
  "why_midpoint": "Ozone is the only brand that marks a \"sweet spot\" inside its range; its sweet-spot centres sit within 0.1 kn of the range mid-points, so the mid-point is taken as the wind each size is designed for.",
  "fit_quality": {
   "mean_abs_err_m2": 0.31,
   "rmse_m2": 0.44,
   "share_within_half_m2": 0.75,
   "share_within_1m2": 0.97,
   "after_rounding_mean_abs_err_m2": 0.25,
   "by_brand": {
    "Gong": {
     "points": 53,
     "bias_m2": 0.14,
     "mean_abs_err_m2": 0.25
    },
    "F-One": {
     "points": 18,
     "bias_m2": -0.5,
     "mean_abs_err_m2": 0.5
    },
    "Duotone": {
     "points": 20,
     "bias_m2": 0.05,
     "mean_abs_err_m2": 0.14
    },
    "Cabrinha": {
     "points": 9,
     "bias_m2": 0.07,
     "mean_abs_err_m2": 0.3
    },
    "Armstrong": {
     "points": 12,
     "bias_m2": -0.02,
     "mean_abs_err_m2": 0.63
    },
    "Slingshot": {
     "points": 10,
     "bias_m2": -0.21,
     "mean_abs_err_m2": 0.32
    },
    "Sroka": {
     "points": 7,
     "bias_m2": -0.1,
     "mean_abs_err_m2": 0.14
    },
    "North": {
     "points": 6,
     "bias_m2": -0.21,
     "mean_abs_err_m2": 0.21
    },
    "Ozone": {
     "points": 6,
     "bias_m2": 0.54,
     "mean_abs_err_m2": 0.54
    }
   },
   "note": "bias = model minus brand at the brand's own range mid-point. Negative = that brand puts a bigger wing at that wind than the model (F-One, Armstrong and Slingshot rate their 3-4.5 m² sizes 3-5 kn windier than Duotone, Cabrinha and Sroka). Positive = brand suggests smaller (Ozone Wasp V3). Biggest single miss: Armstrong XPS Lightwind 8 m², rated 4-11 kn."
  },
  "weight_exponent_note": "a=0.46 comes mainly from Gong (the only brand with per-weight wind charts; a=0.38-0.50 depending on the kg assumed for its S and XL bands). Sroka and North Light Wind rules alone give about 0.55-0.7, and pure physics (constant lift per kg) would give 1.0. Heavier riders also ride bigger foils, which is why the published exponent is well under 1.",
  "wind_exponent_note": "k=0.90, far from the 2 that lift-proportional-to-wind-squared would suggest: brands rate small wings for very wide ranges (riders tolerate being overpowered) and large wings for narrow light-wind ranges, so the mid-points fall slower than 1/V².",
  "rounding": {
   "steps_m2": [
    2.0,
    2.5,
    3.0,
    3.5,
    4.0,
    4.5,
    5.0,
    5.5,
    6.0,
    6.5,
    7.0,
    8.0
   ],
   "rule": "nearest step; ties go to the bigger wing",
   "too_light": "raw size above 8.5 m² -> null (too light: no sensible wing; the biggest common wing is 8 m²)",
   "too_strong": "raw size below 1.75 m², or steady wind above 40 kn -> null. The model never drops below 2 m² before about 49 kn, so the 40 kn cap does the work: it is where every brand's 2 m² range ends (Armstrong 42, Cabrinha/Duotone 45, Slingshot 50)."
  },
  "limits_by_weight": {
   "60": {
    "too_light_below_kn": 8.5,
    "too_strong_from_kn": 40
   },
   "70": {
    "too_light_below_kn": 9.5,
    "too_strong_from_kn": 40
   },
   "80": {
    "too_light_below_kn": 10.0,
    "too_strong_from_kn": 40
   },
   "90": {
    "too_light_below_kn": 10.5,
    "too_strong_from_kn": 40
   },
   "100": {
    "too_light_below_kn": 11.0,
    "too_strong_from_kn": 40
   },
   "110": {
    "too_light_below_kn": 11.5,
    "too_strong_from_kn": 40
   }
  },
  "caveats": [
   "Brand charts assume an intermediate rider on a mid-sized foil. Gong: an 85 kg beginner needs 15-20 kn on a 5 m² to start, an experienced rider about 15 kn, an athletic pumper 12 kn.",
   "Use the steady (mean) wind. In gusty conditions riders size for the lulls if light, the gusts if strong.",
   "Model is fitted to all-round/freeride wings. Light-wind specialist wings (F-One Strike CWC, Armstrong XPS Lightwind, North Nova Light Wind) go 1-3 kn lower for the same size."
  ]
 },
