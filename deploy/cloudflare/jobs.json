{
  "$comment": "Generated by deploy/schedules.py from deploy/local/jobs.toml. Edit that, then rerun.",
  "cronStepMinutes": 5,
  "jobs": [
    {
      "id": "harmonie",
      "enabled": true,
      "description": "HARMONIE-AROME (Met Éireann), hourly DINI cycle",
      "hours": [
        6,
        12
      ],
      "minutes": [
        0
      ],
      "size": "large",
      "timeoutSeconds": 3300,
      "args": [
        "--models",
        "harmonie",
        "--step",
        "1"
      ]
    },
    {
      "id": "icon-eu",
      "enabled": true,
      "description": "ICON-EU wind (DWD)",
      "hours": [
        3
      ],
      "minutes": [
        30
      ],
      "size": "large",
      "timeoutSeconds": 3300,
      "args": [
        "--models",
        "icon-eu",
        "--step",
        "1"
      ]
    },
    {
      "id": "icon-eu-weather",
      "enabled": true,
      "description": "ICON-EU surface weather (DWD)",
      "hours": [
        3
      ],
      "minutes": [
        40
      ],
      "size": "large",
      "timeoutSeconds": 3300,
      "args": [
        "--models",
        "icon-eu-weather"
      ]
    },
    {
      "id": "ecmwf",
      "enabled": true,
      "description": "ECMWF IFS 15-day",
      "minutes": [
        20
      ],
      "size": "large",
      "timeoutSeconds": 3300,
      "args": [
        "--models",
        "ecmwf"
      ]
    },
    {
      "id": "harmonie-eps",
      "enabled": false,
      "description": "HARMONIE ensemble (Met Éireann)",
      "minutes": [
        50
      ],
      "size": "ensemble",
      "timeoutSeconds": 3300,
      "args": [
        "--models",
        "harmonie-eps"
      ]
    },
    {
      "id": "ecmwf-ens",
      "enabled": false,
      "description": "ECMWF ensemble (beyond HARMONIE)",
      "hours": [
        8,
        10
      ],
      "minutes": [
        35
      ],
      "size": "ensemble",
      "timeoutSeconds": 3300,
      "args": [
        "--models",
        "ecmwf-ens"
      ]
    },
    {
      "id": "aifs",
      "enabled": false,
      "description": "ECMWF AIFS (machine-learned)",
      "hours": [
        0,
        6,
        12,
        18
      ],
      "minutes": [
        25
      ],
      "size": "large",
      "timeoutSeconds": 3300,
      "args": [
        "--models",
        "aifs",
        "--ecmwf-source",
        "ecmwf"
      ]
    },
    {
      "id": "gfs",
      "enabled": true,
      "description": "GFS (NOAA)",
      "hours": [
        4,
        10,
        16,
        22
      ],
      "minutes": [
        0
      ],
      "size": "large",
      "timeoutSeconds": 2400,
      "args": [
        "--models",
        "gfs",
        "--step",
        "3"
      ]
    },
    {
      "id": "gefs",
      "enabled": false,
      "description": "GEFS ensemble (NOAA)",
      "hours": [
        5,
        11,
        17,
        23
      ],
      "minutes": [
        10
      ],
      "size": "ensemble",
      "timeoutSeconds": 3300,
      "args": [
        "--models",
        "gefs"
      ]
    },
    {
      "id": "arpege",
      "enabled": false,
      "description": "ARPEGE (Météo-France)",
      "hours": [
        4,
        10,
        16,
        22
      ],
      "minutes": [
        50
      ],
      "size": "large",
      "timeoutSeconds": 3300,
      "args": [
        "--models",
        "arpege",
        "--step",
        "3"
      ]
    },
    {
      "id": "arome",
      "enabled": false,
      "description": "AROME (Météo-France)",
      "hours": [
        1,
        4,
        7,
        10,
        13,
        16,
        19,
        22
      ],
      "minutes": [
        55
      ],
      "size": "large",
      "timeoutSeconds": 3300,
      "args": [
        "--models",
        "arome",
        "--step",
        "3"
      ]
    },
    {
      "id": "gfs-wave",
      "enabled": true,
      "description": "GFS-Wave (NOAA)",
      "hours": [
        4,
        10,
        16,
        22
      ],
      "minutes": [
        30
      ],
      "size": "medium",
      "timeoutSeconds": 2400,
      "args": [
        "--models",
        "gfs-wave"
      ]
    },
    {
      "id": "mi-swan",
      "enabled": true,
      "description": "Irish Shelf SWAN waves (Marine Institute)",
      "hours": [
        10,
        14,
        18
      ],
      "minutes": [
        15
      ],
      "size": "medium",
      "timeoutSeconds": 1800,
      "args": [
        "--models",
        "mi-swan"
      ]
    },
    {
      "id": "ecmwf-wave",
      "enabled": false,
      "description": "ECMWF waves",
      "hours": [
        8,
        20
      ],
      "minutes": [
        45
      ],
      "size": "ensemble",
      "timeoutSeconds": 3300,
      "args": [
        "--models",
        "ecmwf-wave",
        "--ecmwf-source",
        "ecmwf"
      ]
    },
    {
      "id": "tides",
      "enabled": true,
      "description": "Tide predictions (Marine Institute)",
      "hours": [
        1
      ],
      "minutes": [
        5
      ],
      "size": "small",
      "timeoutSeconds": 1800,
      "args": [
        "--models",
        "tides"
      ]
    },
    {
      "id": "sea-temperature",
      "enabled": true,
      "description": "Sea temperature observations",
      "hours": [
        0,
        3,
        6,
        9,
        12,
        15,
        18,
        21
      ],
      "minutes": [
        15
      ],
      "size": "small",
      "timeoutSeconds": 900,
      "args": [
        "--models",
        "sea-temperature"
      ]
    },
    {
      "id": "blend",
      "enabled": true,
      "description": "Every spot's wind blend, for the map's stars",
      "minutes": [
        5
      ],
      "size": "small",
      "timeoutSeconds": 600,
      "args": [
        "--models",
        "blend"
      ]
    },
    {
      "id": "wind-obs",
      "enabled": true,
      "description": "Wind observations (Met Éireann stations, Marine Institute buoys)",
      "minutes": [
        50
      ],
      "size": "small",
      "timeoutSeconds": 600,
      "args": [
        "--models",
        "wind-obs"
      ]
    },
    {
      "id": "forecast-archive",
      "enabled": true,
      "description": "Archive every served wind run and the observations",
      "minutes": [
        15
      ],
      "size": "medium",
      "timeoutSeconds": 1800,
      "args": [
        "--models",
        "forecast-archive"
      ]
    },
    {
      "id": "verify",
      "enabled": true,
      "description": "Score every model and the blend against the observations",
      "hours": [
        7
      ],
      "minutes": [
        25
      ],
      "size": "medium",
      "timeoutSeconds": 1800,
      "args": [
        "--models",
        "verify"
      ]
    },
    {
      "id": "prune",
      "enabled": true,
      "description": "Sweep the bucket: superseded runs past their grace, and objects nothing references",
      "minutes": [
        10
      ],
      "size": "small",
      "timeoutSeconds": 900,
      "entrypoint": [
        "sh",
        "-c",
        "exec python /app/force5/ingest/prune.py --bucket \"$S3_BUCKET\""
      ]
    }
  ]
}
