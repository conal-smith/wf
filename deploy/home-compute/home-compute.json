{
  "$comment": "Generated by deploy/schedules.py from deploy/local/jobs.toml. Edit that, then rerun.",
  "pollEvery": "30s",
  "stateFile": "state/state.json",
  "envFile": ".env",
  "api": {
    "host": "127.0.0.1",
    "port": 4786,
    "tokenEnv": "HOME_COMPUTE_API_TOKEN"
  },
  "history": {
    "keep": 50
  },
  "dashboard": {
    "allowedLoginsEnv": "HOME_COMPUTE_DASHBOARD_LOGINS"
  },
  "timetable": {
    "command": [
      "./macmini.sh",
      "jobs",
      "set"
    ],
    "timeoutSeconds": 120
  },
  "bacalhau": {
    "binary": "bacalhau",
    "apiHost": "127.0.0.1",
    "apiPort": 1234
  },
  "jobs": [
    {
      "id": "harmonie",
      "description": "HARMONIE-AROME (Met Éireann), hourly DINI cycle",
      "schedule": {
        "at": {
          "hours": [
            5,
            8,
            11,
            16,
            19,
            23
          ],
          "minutes": [
            35
          ]
        },
        "timezone": "UTC"
      },
      "labels": {
        "application": "wingfoil",
        "models": "harmonie"
      },
      "task": {
        "image": "${WINGFOIL_IMAGE}",
        "requiredEnv": [
          "S3_BUCKET",
          "S3_ENDPOINT_URL",
          "AWS_ACCESS_KEY_ID",
          "AWS_SECRET_ACCESS_KEY",
          "FORCE5_SIDECARS"
        ],
        "passEnv": [
          "S3_PREFIX",
          "AWS_REGION",
          "ECMWF_SOURCE",
          "FORCE5_BROTLI_QUALITY"
        ],
        "resources": {
          "cpu": "1",
          "memory": "1Gb",
          "disk": "2Gb"
        },
        "network": {
          "type": "Full"
        },
        "timeouts": {
          "queueSeconds": 3600,
          "totalSeconds": 7500
        },
        "entrypoint": [
          "python",
          "/app/force5/ingest/worker.py"
        ],
        "parameters": [
          "--models",
          "harmonie",
          "--step",
          "1"
        ],
        "report": {
          "format": "json-lines",
          "trackEvent": "forecast_complete",
          "trackBy": "model"
        }
      }
    },
