# Copy to deploy/local/.env and edit. Every value has a working default, and none
# of them is a secret: the local deployment uses no cloud account and no API key.

# Where the site listens on the host. 127.0.0.1 keeps it on this machine only; use
# 0.0.0.0 to reach it from the LAN or over Tailscale.
FORCE5_WEB_BIND=127.0.0.1
FORCE5_WEB_PORT=8080

# Caddy's own listen address inside the container. Leave as :8080 unless you also
# change the published port; a hostname here would need TLS handling of its own.
FORCE5_SITE_ADDRESS=:8080

# Retention. Unreferenced run directories survive this many hours after their last
# write, so open browser tabs keep working; raw GRIB caches survive this many days.
FORCE5_RETAIN_HOURS=48
FORCE5_CACHE_DAYS=3

# Container clock. Ingest cadences are UTC regardless; this only affects log times.
FORCE5_TZ=Etc/UTC

# Set to 1 to fire every enabled job once when the scheduler starts, instead of
# waiting for the first cadence slot. Useful on a first run, noisy afterwards.
FORCE5_RUN_AT_START=0

# Image tags and the data volume name, if you keep several deployments side by side.
FORCE5_WORKER_IMAGE=force5-worker:local
FORCE5_WEB_IMAGE=force5-web:local
FORCE5_DATA_VOLUME=force5-data
