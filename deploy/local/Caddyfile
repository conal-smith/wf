# Force5 local deployment: the built site and the ingest volume on one origin, so
# the browser needs no VITE_FORECAST_BASE_URL and no CORS. Plain HTTP for a LAN or
# Tailscale address; terminate TLS with `tailscale serve` or a reverse proxy.
{
	admin off
	auto_https off
	log {
		output stdout
		format console
	}
}

{$FORCE5_SITE_ADDRESS::8080} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Forecast and marine output written by the ingest worker into the shared volume.
	@data path /weather/* /marine/*
	handle @data {
		root * /data/public
		# Manifests and the JSON frames are typed explicitly because they have no
		# extension the MIME table would help with in every image; wind frames are
		# binary tiles (force5/ingest/f5tile.py) and must not be mislabelled as JSON, which
		# is why the content type is matched rather than set for everything here.
		@json path *.json
		@bin path *.bin
		header @json Content-Type "application/json; charset=utf-8"
		header @bin Content-Type "application/octet-stream"
		# Everything the importers publish immutably is content-addressed: any file
		# inside a run directory, which is named for the hash of its content
		# (weather/harmonie-2026101106-61h-v2-1a2b3c4d/t/1/26/6/000.bin, a wind tile, and its
		# spots/n52w010.json squares, force5/ingest/rundir.py), or a file whose
		# name ends in its content hash (marine/tides-DUBLIN-20260914-20260923-<hash>.json).
		# The first matching handle wins, so the pointer manifests, and a staging
		# directory an import has not finished, fall through to revalidation.
		@immutable path_regexp ^/(?:weather|marine)/(?:[a-z0-9][a-z0-9.-]*-[0-9a-f]{8}/.+|[^/]*-[0-9a-f]{8,}\.json)$
		handle @immutable {
			header Cache-Control "public, max-age=31536000, immutable"
			# The ingest worker writes `name.br` and `name.gz` beside every file of
			# a run, binary frames and spot squares alike, so the browser is served
			# the encoding it asked for without Caddy compressing anything on the
			# fly. `encode` above only covers its default content types and would
			# leave a frame as it found it. An absent sidecar simply serves the
			# plain file.
			file_server {
				precompressed br gzip
			}
		}
		# Pointer manifests are replaced in place whenever a new run publishes.
		handle {
			header Cache-Control "max-age=0, must-revalidate"
			file_server
		}
	}

	handle {
		root * /srv
		# Vite emits content-hashed asset names, including MapLibre's ES module worker.
		@asset path /assets/*
		@script path *.js *.mjs
		@entry path / /index.html
		header @asset Cache-Control "public, max-age=31536000, immutable"
		header @entry Cache-Control "max-age=0, must-revalidate"
		header @script Content-Type "text/javascript; charset=utf-8"
		try_files {path} /index.html
		file_server
	}
}
