# Force5 local deployment: the built site and the ingest volume on one origin, so
# the browser needs no VITE_FORECAST_BASE_URL and no CORS. Plain HTTP for a LAN or
# Tailscale address; terminate TLS with `tailscale serve` or a reverse proxy.
{
	admin off
	auto_https off
	log {
		output stdout
		format console
	}
}

{$FORCE5_SITE_ADDRESS::8080} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Forecast and marine output written by the ingest worker into the shared volume.
	@data path /weather/* /marine/*
	handle @data {
		root * /data/public
		header Content-Type "application/json; charset=utf-8"
		# Everything the importers publish immutably is content-addressed: a frame
		# inside a run directory, or a file whose name ends in its content hash
		# (marine/tides-DUBLIN-20260914-20260923-<hash>.json). The first matching
		# handle wins, so only the pointer manifests fall through to revalidation.
		@immutable path_regexp ^/(?:weather|marine)/(?:[^/]+/.+|[^/]*-[0-9a-f]{8,}\.json)$
		handle @immutable {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# Pointer manifests are replaced in place whenever a new run publishes.
		handle {
			header Cache-Control "max-age=0, must-revalidate"
			file_server
		}
	}

	handle {
		root * /srv
		# Vite emits content-hashed asset names, including MapLibre's ES module worker.
		@asset path /assets/*
		@script path *.js *.mjs
		@entry path / /index.html
		header @asset Cache-Control "public, max-age=31536000, immutable"
		header @entry Cache-Control "max-age=0, must-revalidate"
		header @script Content-Type "text/javascript; charset=utf-8"
		try_files {path} /index.html
		file_server
	}
}
