# Static site image for the local deployment: build with Node 22, serve with Caddy.
# No VITE_FORECAST_BASE_URL is set, so the browser reads /weather/* from this same
# origin, where Caddy serves the ingest volume.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
# Every source the site's own `npm run build` reads (tsc -b type-checks the tests
# under each tsconfig.json entry too, and some import across the tree). The
# .dockerignore allowlist decides what that is; CI builds this image on every
# change, so a section the allowlist misses fails there rather than at release.
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY deploy/local/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
# The volume is created from these directories, so the non-root worker (uid 10001)
# can write to /data whichever service mounts it first.
RUN mkdir -p /data/public/weather /data/public/marine && chown -R 10001:10001 /data \
    && caddy validate --config /etc/caddy/Caddyfile
EXPOSE 8080
