# Static site image for the local deployment: build with Node 22, serve with Caddy.
# No VITE_FORECAST_BASE_URL is set, so the browser reads /weather/* from this same
# origin, where Caddy serves the ingest volume.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
COPY data ./data
COPY force5 ./force5
# src/main.tsx lazy-loads the marketplace bundle; only its browser half is built here.
COPY market/web ./market/web
COPY market/shared ./market/shared
# It also reads the site's user types, and the auth bridge and fetch core every section shares.
COPY site/shared ./site/shared
COPY shared ./shared
# And the community bundle, which tsconfig.json type-checks and ui/theme.css scans.
COPY community/web ./community/web
COPY community/shared ./community/shared
# tsc -b checks the tests under those directories too; two import across the tree.
COPY community/api/seed.ts ./community/api/seed.ts
COPY market/api/src/ids.ts ./market/api/src/ids.ts
# src/main.tsx imports the Tailwind theme, which also names the directories scanned for classes.
COPY ui ./ui
COPY public ./public
RUN npm run build

FROM caddy:2-alpine
COPY deploy/local/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
# The volume is created from these directories, so the non-root worker (uid 10001)
# can write to /data whichever service mounts it first.
RUN mkdir -p /data/public/weather /data/public/marine && chown -R 10001:10001 /data \
    && caddy validate --config /etc/caddy/Caddyfile
EXPOSE 8080
