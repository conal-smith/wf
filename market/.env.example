# ---- marketplace API (market/api) ------------------------------------------
# Copy to .env at the repository root, or set these on the Railway service.

PORT=8787
# Where browsers reach this API; used to build upload URLs for the local driver.
MARKET_PUBLIC_URL=http://127.0.0.1:8787
# Comma-separated website origins allowed to call the API. Required in production.
MARKET_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Database. Railway injects DATABASE_URL when a Postgres service is attached.
DATABASE_URL=postgres://market:market@127.0.0.1:55432/market
# MARKET_DB=memory            # throwaway in-memory store; refused in production

# Auth. Production verifies Clerk session tokens.
CLERK_SECRET_KEY=sk_test_...
# CLERK_JWT_KEY=              # optional PEM public key for networkless verification
# CLERK_AUTHORIZED_PARTIES=https://wingfoil.ie
# MARKET_AUTH_MODE=dev        # accept "Bearer dev:<name>" instead; refused in production

# Photos. s3 works with AWS S3, Cloudflare R2 and Railway buckets.
MARKET_STORAGE=s3
MARKET_S3_BUCKET=wingfoil-market
MARKET_S3_REGION=auto
MARKET_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
MARKET_S3_PUBLIC_BASE_URL=https://market-cdn.wingfoil.ie
MARKET_S3_PREFIX=market
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# MARKET_S3_FORCE_PATH_STYLE=true   # MinIO and some S3-compatible stores
# MARKET_STORAGE=local              # store on disk instead (development, or a Railway volume)
# MARKET_UPLOAD_DIR=.cache/market-uploads
# MARKET_UPLOAD_SECRET=             # HMAC secret for local upload URLs; random per boot if unset

# The MCP endpoint (/api/mcp, mcp/api/server.ts) reads the forecast the site
# publishes from here. Unset: the checkout's public/ in development, and
# /api/mcp is off in production.
# FORECAST_BASE_URL=https://wingfoil.ie/

# ---- feature switches --------------------------------------------------------
# Each section is off unless set to 1. Off, the API answers 404 off for it (the
# marketplace keeps /api/market/health) and Gust says he is off. The website
# has the same switches at build time, below: turn both on together.
# FEATURE_GUST=1
# FEATURE_MARKET=1
# FEATURE_COMMUNITY=1
# FEATURE_ALERTS=1             # the app's star-condition alerts, /api/alerts (alerts/README.md)

# Star-condition alerts, with FEATURE_ALERTS=1. Rules are read from
# weather/blend.json at FORECAST_BASE_URL (the data host,
# https://data.wingfoil.ie/).
# ALERTS_EVALUATE=1            # this instance evaluates and sends, every 15 minutes
# ALERTS_ADMIN_TOKEN=          # bearer for POST /api/alerts/announce (release pipeline), 24+ chars
# EXPO_ACCESS_TOKEN=           # only with Expo's enhanced push security on

# ---- website (Vite, build time) ---------------------------------------------
# VITE_FEATURE_GUST=1          # off: Gust never appears
# VITE_FEATURE_MARKET=1        # off: no Marketplace in the menu; /market goes to /
# VITE_FEATURE_COMMUNITY=1     # off: no Community in the menu; /community goes to /
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_MARKET_API_URL=https://market-api.up.railway.app   # unset = same origin (/api proxy in dev)
# VITE_MARKET_DEV_USER=aoife   # sign in as a fixed dev identity; pair with MARKET_AUTH_MODE=dev

# Gust, the in-app companion (/api/companion, companion/api), with FEATURE_GUST=1.
# Without a key Gust is asleep: the chat answers 503 not_configured and the site
# says so. With one, a monthly budget is required; once a calendar month's (UTC)
# estimated spend reaches it, Gust disappears from the site until the 1st and the
# chat answers 503 budget_exhausted, pointing riders at /ai.
# ANTHROPIC_API_KEY=sk-ant-...
# COMPANION_MONTHLY_BUDGET_USD=200
# COMPANION_MODEL=claude-haiku-5-5   # must be priced in companion/api/budget.ts
# COMPANION_EFFORT=low         # low | medium | high | xhigh | max; low keeps chat quick
# COMPANION_FAKE=1             # a scripted model for demos and e2e; refused in production
