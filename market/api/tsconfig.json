{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "rootDir": "../..",
    "outDir": "./dist"
  },
  "include": [
    "src",
    "../shared",
    "../../site/api",
    "../../site/shared",
    "../../community/api",
    "../../community/shared",
    "../../mcp/api"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "../../site/**/*.test.ts",
    "../../community/**/*.test.ts",
    "../../mcp/**/*.test.ts",
    "../../mcp/api/testing.ts"
  ]
}
