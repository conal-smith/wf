{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "rootDir": "../..",
    "outDir": "./dist"
  },
  "include": ["src", "../shared", "../../site/api", "../../site/shared"],
  "exclude": ["src/**/*.test.ts", "../../site/**/*.test.ts"]
}
