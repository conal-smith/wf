  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:tokens": "node scripts/build-tokens.mjs --check && node scripts/lint-design-tokens.mjs --selftest && node scripts/lint-design-tokens.mjs",
