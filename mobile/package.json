    "ci": "npm run typecheck && npm run lint && npm run lint:tokens && npm test",
    "export:check": "expo export --platform ios --platform android --output-dir dist --max-workers 2",
    "fingerprint": "expo-updates fingerprint:generate",
    "brand:icons": "node scripts/brand-icons.mjs",
    "tokens": "node scripts/build-tokens.mjs"
