{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "maplibre-gl": ["./node_modules/@maplibre/maplibre-gl-style-spec"]
    }
  },
  "include": ["src", "app.config.ts", "expo-env.d.ts", ".expo/types/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.test.ts", ".test-build"]
}
