{
  "name": "wingfoil-ie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e *.ts *.md index.html package.json",
    "design:build": "node design/scripts/build-tokens.mjs && node design/scripts/build-catalog.mjs",
    "design:lint": "npm run design:build && node design/scripts/lint.mjs",
    "spots:export": "node scripts/export-riding-locations.mjs",
    "test:weather": ".venv/bin/python -m unittest discover -s force5/ingest -p 'test_*.py'",
    "weather:refresh": ".venv/bin/python force5/ingest/fetch_forecast.py",
    "weather:refresh:harmonie": ".venv/bin/python force5/ingest/fetch_harmonie.py",
    "weather:refresh:ecmwf": ".venv/bin/python force5/ingest/fetch_ecmwf.py",
    "weather:refresh:gfs": ".venv/bin/python force5/ingest/fetch_gfs.py",
    "weather:refresh:gefs": ".venv/bin/python force5/ingest/fetch_gefs.py",
    "weather:refresh:ecmwf-ens": ".venv/bin/python force5/ingest/fetch_ecmwf_ens.py",
    "weather:refresh:harmonie-eps": ".venv/bin/python force5/ingest/fetch_harmonie_eps.py",
    "weather:refresh:mi-swan": ".venv/bin/python force5/ingest/fetch_mi_swan.py",
    "weather:refresh:gfs-wave": ".venv/bin/python force5/ingest/fetch_gfswave.py",
    "weather:refresh:icon-weather": ".venv/bin/python force5/ingest/fetch_icon_weather.py",
    "tides:refresh": ".venv/bin/python force5/ingest/fetch_tides.py",
    "deploy:build": "docker compose -f deploy/local/docker-compose.yml build",
    "deploy:up": "docker compose -f deploy/local/docker-compose.yml up -d",
    "deploy:down": "docker compose -f deploy/local/docker-compose.yml down",
    "deploy:logs": "docker compose -f deploy/local/docker-compose.yml logs -f --tail=100",
    "deploy:status": "docker compose -f deploy/local/docker-compose.yml run --rm status",
    "deploy:schedule": "docker compose -f deploy/local/docker-compose.yml run --rm scheduler --list",
    "deploy:run": "docker compose -f deploy/local/docker-compose.yml run --rm worker",
    "deploy:prune": "docker compose -f deploy/local/docker-compose.yml run --rm prune"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
