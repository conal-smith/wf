{
  "name": "wingfoil-ie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "map:shots": "MAP_SHOTS=1 playwright test --project=map-shots",
    "shots:compare": "node scripts/shots-compare.mjs",
    "preview:e2e": "node scripts/e2e-site.mjs && E2E_SITE=1 VITE_MARKET_DEV_SWITCH=1 npm run build && E2E_SITE=1 npm run preview --",
    "format": "prettier --write src tests e2e scripts *.ts *.md index.html package.json",
    "ui:lint": "node scripts/lint-ui.mjs && node scripts/lint-ui.mjs --probe && node scripts/lint-design-tokens.mjs && node scripts/lint-design-tokens.mjs --probe && node scripts/lint-raw-primitives.mjs && node scripts/lint-raw-primitives.mjs --probe && node design-system/scripts/lint.mjs",
    "design:build": "node design-system/scripts/build-tokens.mjs && node design-system/scripts/build-catalog.mjs",
    "spots:export": "node scripts/export-riding-locations.mjs",
    "spots:facing": "node scripts/shore-facing.mjs",
    "market:api": "tsx watch market/api/src/index.ts",
    "market:api:build": "tsc -p market/api/tsconfig.json",
    "market:api:start": "node market/api/dist/market/api/src/index.js",
    "market:db": "docker compose -f market/docker-compose.yml up -d",
    "market:shots": "MARKET_SHOTS=1 playwright test --project=market-shots",
    "test:weather": ".venv/bin/python -m unittest discover -s force5/ingest -p 'test_*.py'",
    "weather:sample": "node scripts/sample-weather.mjs --all",
    "weather:fixtures": "node scripts/sample-weather.mjs --out tests/fixtures/weather --force",
    "weather:refresh": ".venv/bin/python force5/ingest/fetch_forecast.py",
    "weather:refresh:harmonie": ".venv/bin/python force5/ingest/fetch_harmonie.py",
    "weather:refresh:ecmwf": ".venv/bin/python force5/ingest/fetch_ecmwf.py",
    "weather:refresh:gfs": ".venv/bin/python force5/ingest/fetch_gfs.py",
    "weather:refresh:gefs": ".venv/bin/python force5/ingest/fetch_gefs.py",
    "weather:refresh:arpege": ".venv/bin/python force5/ingest/fetch_arpege.py",
    "weather:refresh:arome": ".venv/bin/python force5/ingest/fetch_arome.py",
    "weather:refresh:ecmwf-ens": ".venv/bin/python force5/ingest/fetch_ecmwf_ens.py",
    "weather:refresh:aifs": ".venv/bin/python force5/ingest/fetch_aifs.py",
    "weather:refresh:ecmwf-wave": ".venv/bin/python force5/ingest/fetch_ecmwf_wave.py",
    "weather:refresh:harmonie-eps": ".venv/bin/python force5/ingest/fetch_harmonie_eps.py",
    "weather:refresh:mi-swan": ".venv/bin/python force5/ingest/fetch_mi_swan.py",
    "weather:refresh:gfs-wave": ".venv/bin/python force5/ingest/fetch_gfswave.py",
    "weather:refresh:icon-weather": ".venv/bin/python force5/ingest/fetch_icon_weather.py",
    "tides:refresh": ".venv/bin/python force5/ingest/fetch_tides.py",
    "sea:refresh": ".venv/bin/python force5/ingest/fetch_sea_temperature.py",
    "deploy:build": "docker compose -f deploy/local/docker-compose.yml build",
    "deploy:up": "docker compose -f deploy/local/docker-compose.yml up -d",
    "deploy:down": "docker compose -f deploy/local/docker-compose.yml down",
    "deploy:logs": "docker compose -f deploy/local/docker-compose.yml logs -f --tail=100",
    "deploy:status": "docker compose -f deploy/local/docker-compose.yml run --rm status",
    "deploy:schedule": "docker compose -f deploy/local/docker-compose.yml run --rm scheduler --list",
    "deploy:run": "docker compose -f deploy/local/docker-compose.yml run --rm worker",
    "deploy:prune": "docker compose -f deploy/local/docker-compose.yml run --rm prune"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@clerk/backend": "^3.18.1",
    "@clerk/clerk-react": "^5.61.9",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "hono": "^4.13.8",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.9.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pbf": "^5.1.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
