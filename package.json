{
  "name": "wingfoil-ie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e *.ts *.md index.html package.json",
    "test:weather": ".venv/bin/python -m unittest discover -s force5/ingest -p 'test_*.py'",
    "weather:refresh": ".venv/bin/python force5/ingest/fetch_forecast.py",
    "weather:refresh:harmonie": ".venv/bin/python force5/ingest/fetch_harmonie.py",
    "weather:refresh:ecmwf": ".venv/bin/python force5/ingest/fetch_ecmwf.py",
    "weather:refresh:gfs": ".venv/bin/python force5/ingest/fetch_gfs.py"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
